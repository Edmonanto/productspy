# Postgres — use the Supabase connection string (Project Settings -> Database)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase JWT secret (Project Settings -> API -> JWT Secret).
# Must match the project the frontend authenticates against.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://productspy.pro

# ── Ingestion (Phase 2) ─────────────────────────────────────────────
# AliExpress Affiliate/Dropshipping API — apply via AliExpress Portals (free)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=productspy

# Apify — one actor id per source you want; leave blank to skip that source
APIFY_TOKEN=
APIFY_AMAZON_ACTOR=
APIFY_TIKTOK_ACTOR=
APIFY_ADS_ACTOR=

# Claude — generates each product's ai_summary during ingestion
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

INGEST_LIMIT=50
TREND_WINDOW_DAYS=7

# ── Billing (Phase 3) ───────────────────────────────────────────────
APP_URL=https://productspy.pro

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Use api-m.sandbox.paypal.com while testing
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_AGENCY=

# ── 1688 Open Platform (wholesale source) ───────────────────────────
ALIBABA1688_APP_KEY=
ALIBABA1688_APP_SECRET=
ALIBABA1688_ACCESS_TOKEN=
# Adjust to whichever service package your app is granted
ALIBABA1688_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA1688_API_NAME=product.search.keywordQuery
ALIBABA1688_KEYWORDS=
ALIBABA1688_CATEGORY_ID=
CNY_PER_USD=7.15
WHOLESALE_MARKUP=3.0
