# Postgres — use the Supabase connection string (Project Settings -> Database)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase JWT secret (Project Settings -> API -> JWT Secret).
# Must match the project the frontend authenticates against.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://productspy.pro

# 1688 data provider — each endpoint has its own metered token
ALI1688_SEARCH_TOKEN=
ALI1688_DETAIL_TOKEN=
# ALI1688_SEARCH_URL=http://175.178.149.181:5432/1688_keyword_search-pc
# ALI1688_DETAIL_URL=http://114.132.60.246:8010/1688_item_detail_info

# Optional tuning (defaults shown)
# CNY_TO_USD=0.14
# RETAIL_MARKUP=3.0
# SEARCH_CACHE_TTL_HOURS=12
# DETAIL_CACHE_TTL_HOURS=72
# DETAIL_AUTO_FETCH=true
