# Postgres — use the Supabase connection string (Project Settings -> Database).
# Prefer the session pooler host: the direct db.*.supabase.co host is IPv6-only
# and unreachable from IPv4-only hosts such as Render's free tier. The pooler
# also needs the username form postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.your-project@aws-1-region.pooler.supabase.com:5432/postgres

# Supabase project URL. Required: Supabase signs access tokens with an
# asymmetric key (ES256), and the public half is fetched from this project's
# JWKS endpoint to verify them. Without it, every ES256 token answers 500.
# Same public value the frontend ships as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase JWT secret (Project Settings -> API -> JWT Secret).
# Only needed by projects still signing HS256; a project using asymmetric
# keys verifies through SUPABASE_URL above and can leave this empty.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://productspy.pro

# ── Ingestion (Phase 2) ─────────────────────────────────────────────
# AliExpress Affiliate/Dropshipping API — apply via AliExpress Portals (free)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=productspy

# Search terms define your catalogue — the actor returns nothing without them
# Raw JSON override for an actor with a different input schema

# Claude — generates each product's ai_summary during ingestion
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

INGEST_LIMIT=50
TREND_WINDOW_DAYS=7

# ── Billing (Phase 3) ───────────────────────────────────────────────
APP_URL=https://productspy.pro

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Use api-m.sandbox.paypal.com while testing
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_AGENCY=

# ── 1688 Open Platform (wholesale source) ───────────────────────────
ALIBABA1688_APP_KEY=
ALIBABA1688_APP_SECRET=
ALIBABA1688_ACCESS_TOKEN=
# Adjust to whichever service package your app is granted
ALIBABA1688_NAMESPACE=com.alibaba.fenxiao.crossborder
ALIBABA1688_API_NAME=product.search.keywordQuery
ALIBABA1688_KEYWORDS=
ALIBABA1688_CATEGORY_ID=
CNY_PER_USD=7.15
WHOLESALE_MARKUP=3.0

# ── 1688 via third-party aggregator (no approval needed) ────────────
# WARNING: plain HTTP on bare IPs — token and data travel unencrypted.
AGG1688_SEARCH_URL=http://175.178.149.181:5432/1688_keyword_search-pc
AGG1688_SEARCH_TOKEN=
AGG1688_DETAIL_URL=http://114.132.60.246:8010/1688_item_detail_info
AGG1688_DETAIL_TOKEN=
AGG1688_KEYWORDS=衣服,鞋子,手机壳
AGG1688_ENRICH_TOP=0
AGG1688_INCLUDE_ADS=

# ── TikTok Shop (demand + trend; real USD retail price) ─────────────
TIKTOK_API_BASE=https://jhzyapi.com/api/tiktok/v1/shop
TIKTOK_TOKEN=
TIKTOK_KEYWORDS=cat,pet bed,phone case
TIKTOK_SELLER_IDS=
TIKTOK_ENRICH_TOP=0

# ── Amazon (retail price anchor, multi-marketplace) ─────────────────
AMAZON_API_BASE=https://jhzyapi.com/api/amazon/v1
AMAZON_TOKEN=
AMAZON_KEYWORDS=usb c cable,phone case,cat bed
AMAZON_SITES=US,UK,DE
# FX to USD — non-USD sites are dropped if the rate is missing
USD_PER_GBP=1.27
USD_PER_EUR=1.08

# ── Matching (needs ANTHROPIC_API_KEY for title translation) ────────
MATCH_TRANSLATE_LIMIT=120
MATCH_RETAIL_LIMIT=50
MATCH_SUPPLIER_LIMIT=300
