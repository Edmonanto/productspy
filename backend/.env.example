# Postgres — use the Supabase connection string (Project Settings -> Database).
# Prefer the session pooler host: the direct db.*.supabase.co host is IPv6-only
# and unreachable from IPv4-only hosts such as Render's free tier. The pooler
# also needs the username form postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.your-project@aws-1-region.pooler.supabase.com:5432/postgres

# Supabase project URL. Required: Supabase signs access tokens with an
# asymmetric key (ES256), and the public half is fetched from this project's
# JWKS endpoint to verify them. Without it, every ES256 token answers 500.
# Same public value the frontend ships as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase JWT secret (Project Settings -> API -> JWT Secret).
# Only needed by projects still signing HS256; a project using asymmetric
# keys verifies through SUPABASE_URL above and can leave this empty.
SUPABASE_JWT_SECRET=your-jwt-secret

# Origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://productspy.pro

# Claude — names the product behind each ad, dedupes, flags IP/restricted risk
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Free trial (no card) ────────────────────────────────────────────
TRIAL_DAYS=7
TRIAL_PLAN=pro
# Trial reminder emails (resend.com). Optional — without it no emails are sent.
RESEND_API_KEY=
EMAIL_FROM=ProductSpy Pro <hello@productspy.pro>

# ── Billing (Phase 3) ───────────────────────────────────────────────
APP_URL=https://productspy.pro

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Use api-m.sandbox.paypal.com while testing
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_AGENCY=

# ── Daily Winners (ad libraries + TikTok, one scan per day) ─────────
WINNERS_MARKETS=US,UK,EU,AU,AE,CA
# Model for product naming/dedupe; defaults to ANTHROPIC_MODEL
WINNERS_MODEL=
COLLECT_META=true
COLLECT_TIKTOK_ADS=true
COLLECT_TIKTOK_ORGANIC=true
# Meta Ad Library API — EU markets only (commercial ads, DSA). Others use the web scraper.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
META_WEB_SCRAPER=true
# Residential proxy; PROXY_URL_<MARKET> (e.g. PROXY_URL_AE) overrides per market
PROXY_URL=
# Paid sources — replace the scrapers when enabled
USE_APIFY=
APIFY_TOKEN=
APIFY_META_ACTOR=curious_coder~facebook-ads-library-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_TIKTOK_ADS_ACTOR=
TIKTOK_MIN_VIEWS=100000
TIKTOK_CC_PERIOD=7
ENRICH_ALIEXPRESS=true

# FX to USD for store prices — a price in an unlisted currency is dropped, never guessed
USD_PER_GBP=1.27
USD_PER_EUR=1.08
USD_PER_CAD=0.73
USD_PER_AUD=0.66
USD_PER_AED=0.272
USD_PER_SAR=0.267
